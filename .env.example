APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Comma-separated URL host suffixes allowed for real adapters.
# Keep internal/staging domains here; mock adapters work without external targets.
ALLOWED_HOST_SUFFIXES=.internal,.test,localhost,127.0.0.1

DATABASE_BACKEND=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

SIM_OTP_API_BASE_URL=
SIM_OTP_API_KEY=
PROXYVN_API_KEY=
PROXYVN_BASE_URL=https://proxy.vn/apiv2
PROXYVN_DEFAULT_LOAIPROXY=4Gvinaphone
PROXYVN_DEFAULT_DAYS=1
PROXYVN_DEFAULT_TYPE=HTTP
CAPTCHA_PROVIDER_ENABLED=false
CAPTCHA_PROVIDER_BASE_URL=
CAPTCHA_PROVIDER_API_KEY=
BROWSER_PROFILE_STORAGE_ROOT=.profiles
CLOAKBROWSER_ENABLED=true
CLOAKBROWSER_BINARY_PATH=
CLOAKBROWSER_HEADLESS=false
CLOAKBROWSER_HUMANIZE=true
CLOAKBROWSER_FILTER_NO_SANDBOX=true
CLOAKBROWSER_FIT_SCREEN=true
CLOAKBROWSER_START_MAXIMIZED=true
# Leave 0 to auto-detect the current Windows work area.
CLOAKBROWSER_WINDOW_WIDTH=0
CLOAKBROWSER_WINDOW_HEIGHT=0

MAX_GLOBAL_CONCURRENCY=2
MAX_SITE_CONCURRENCY=1
